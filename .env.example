# Copy this file to .env for local development. Process environment variables
# override values in .env. Generated videos, frames, artifacts, and exports live here.
ROOMSPLAT_DATA_DIR=./data

# Backward-compatible alias used only when ROOMSPLAT_DATA_DIR is unset.
DATA_DIR=./data

# Optional ffmpeg executable path. Leave empty to use ffmpeg from PATH.
ROOMSPLAT_FFMPEG_PATH=

# Backward-compatible alias used only when ROOMSPLAT_FFMPEG_PATH is unset.
FFMPEG_PATH=

# Optional COLMAP executable path for real sparse point-cloud reconstruction.
# Leave empty to use colmap.exe from PATH.
ROOMSPLAT_COLMAP_PATH=

# Backward-compatible alias used only when ROOMSPLAT_COLMAP_PATH is unset.
COLMAP_PATH=

# Optional Nerfstudio CLI configuration for real Gaussian splat reconstruction.
# Leave empty to use ns-process-data, ns-train, and ns-export from PATH.
# Set ROOMSPLAT_NERFSTUDIO_BIN_DIR to the Scripts/bin folder of an isolated Nerfstudio environment,
# or set the individual executable paths below.
# Windows note: install/run Nerfstudio from a Visual Studio Developer Command Prompt
# when CUDA extensions need cl.exe, and make sure CUDA Toolkit/nvcc is available.
ROOMSPLAT_NERFSTUDIO_BIN_DIR=
ROOMSPLAT_NS_PROCESS_DATA_PATH=
ROOMSPLAT_NS_TRAIN_PATH=
ROOMSPLAT_NS_EXPORT_PATH=

# Maximum accepted upload size in megabytes. Default in code: 2048 MB.
ROOMSPLAT_MAX_UPLOAD_MB=2048

# Startup convention for local development. Bind to 127.0.0.1 unless you add auth.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend build-time backend URL. Vite only exposes variables with VITE_ prefix.
VITE_ROOMSPLAT_API_URL=http://127.0.0.1:8000

# Optional ffmpeg timeout for frame extraction jobs, in seconds.
ROOMSPLAT_FFMPEG_TIMEOUT_SECONDS=1800
